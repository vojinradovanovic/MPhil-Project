FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   0.001;

#include "$FOAM_CASE/system/initialConditions"

vertices
(
    ($startCoordinate   $midWallCoordinate  -0.5)
    ($startCoordinate   $highWallCoordinate -0.5)
    (0                  $lowWallCoordinate  -0.5)
    (0                  $midWallCoordinate  -0.5)
    (0                  $highWallCoordinate -0.5)
    ($endCoordinate     $lowWallCoordinate  -0.5)
    ($endCoordinate     $midWallCoordinate  -0.5)
    ($endCoordinate     $highWallCoordinate -0.5)

    ($startCoordinate   $midWallCoordinate  0.5)
    ($startCoordinate   $highWallCoordinate 0.5)
    (0                  $lowWallCoordinate  0.5)
    (0                  $midWallCoordinate  0.5)
    (0                  $highWallCoordinate 0.5)
    ($endCoordinate     $lowWallCoordinate  0.5)
    ($endCoordinate     $midWallCoordinate  0.5)
    ($endCoordinate     $highWallCoordinate 0.5)
);

blocks
(
    hex (0 3 4 1 8 11 12 9)
    ($inletRes_x $inletRes_y 1)
    simpleGrading (1 1 1)

    hex (2 5 6 3 10 13 14 11)
    ($pipeRes_x $stepRes_y 1)
    simpleGrading (1 1 1)

    hex (3 6 7 4 11 14 15 12)
    ($pipeRes_x $inletRes_y 1)
    simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 1 9 8)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (5 6 14 13)
            (6 7 15 14)
        );
    }
    upperWall
    {
        type wall;
        faces
        (
            (1 4 12 9)
            (4 7 15 12)
        );
    }
    lowerWall
    {
        type wall;
        faces
        (
            (0 3 11 8)
            (3 2 10 11)
            (2 5 13 10)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 4 1)
            (2 5 6 3)
            (3 6 7 4)
            (8 11 12 9)
            (10 13 14 11)
            (11 14 15 12)
        );
    }
);


